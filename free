              <button type="submit" className="px-4 py-2 bg-amber-500 text-black font-bold border-2 border-black rounded text-xs active:scale-95 font-mono shadow-[2px_2px_0px_#000]">
                新增
              </button>
            </form>

            {/* CHECKLIST */}
            <div className="space-y-2">
              {todos.map((todo) => (
                <div
                  key={todo.id}
                  onClick={() => handleToggleTodo(todo.id, todo.done)}
                  className={`p-3.5 rounded-lg border-4 border-black shadow-[4px_4px_0px_#000] flex items-center justify-between cursor-pointer transition active:scale-95 ${
                    todo.done ? 'bg-black/80 opacity-60' : 'bg-[#1c120c]/95'
                  }`}
                >
                  <div className="flex items-center space-x-3">
                    <input
                      type="checkbox"
                      checked={todo.done}
                      readOnly
                      className="w-4 h-4 accent-amber-500 rounded"
                    />
                    <span className={`text-xs font-medium ${todo.done ? 'line-through text-stone-500' : 'text-stone-100'}`}>
                      {todo.text}
                    </span>
                  </div>
                  <span className="text-[10px] bg-black text-amber-300 px-2 py-0.5 rounded font-mono border border-stone-700">
                    @{todo.assignee}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ----------------------------------------------------------------- */}
        {/* TAB 6: MEMBERS (隊員組隊)                                          */}
        {/* ----------------------------------------------------------------- */}
        {activeTab === 'members' && (
          <div className="space-y-4">
            <h3 className="font-bold text-xs text-amber-300 font-mono uppercase bg-black/80 px-2.5 py-1 rounded border border-amber-500/40">DUNGEON PARTY ROSTER (遠征隊伍狀態)</h3>
            <div className="grid grid-cols-1 gap-3">
              {MEMBERS.map((member) => (
                <div 
                  key={member.id} 
                  className={`p-4 rounded-lg border-4 border-black shadow-[5px_5px_0px_#000] flex items-center space-x-4 transition ${
                    member.isPresent ? 'bg-[#1c120c]/95' : 'bg-black/80 opacity-60'
                  }`}
                >
                  <div className="w-12 h-12 rounded bg-black border-2 border-stone-700 flex items-center justify-center text-2xl shadow-inner relative">
                    {member.avatar}
                    <span className={`absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full border-2 border-black ${member.isPresent ? 'bg-emerald-500' : 'bg-red-500'}`}></span>
                  </div>
                  <div className="flex-1">
                    <div className="flex justify-between items-center">
                      <h4 className="font-extrabold text-white text-sm font-mono flex items-center gap-2">
                        <span>{member.name}</span>
                        {member.isPresent ? (
                          <span className="text-[9px] bg-emerald-950 text-emerald-300 px-1.5 py-0.5 rounded border border-emerald-500 font-bold">ONLINE</span>
                        ) : (
                          <span className="text-[9px] bg-red-950 text-red-400 px-1.5 py-0.5 rounded border border-red-700 font-bold">OFFLINE</span>
                        )}
                      </h4>
                      <span className="text-[10px] bg-amber-500 text-black px-2 py-0.5 rounded font-black font-mono">
                        {member.role}
                      </span>
                    </div>
                    <p className="text-xs text-stone-400 font-mono mt-0.5">職業 / 裝備: {member.class} • {member.armor}</p>
                    <div className="mt-2 flex items-center space-x-2">
                      <span className={`text-[10px] font-mono font-bold ${member.isPresent ? 'text-emerald-400' : 'text-stone-500'}`}>
                        HP {member.hp}
                      </span>
                      <div className="flex-1 bg-black h-2 rounded overflow-hidden border border-stone-700">
                        <div className={`h-full ${member.isPresent ? 'bg-emerald-500 w-full' : 'bg-stone-700 w-0'}`}></div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </main>

      {/* ------------------------------------------------------------------- */}
      {/* EVENT DETAIL MODAL                                                  */}
      {/* ------------------------------------------------------------------- */}
      {selectedEvent && (
        <div className="fixed inset-0 bg-black/80 z-50 flex items-center justify-center p-4">
          <div className="bg-[#1c120c] w-full max-w-sm rounded-lg border-4 border-black p-5 space-y-4 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button
              onClick={() => setSelectedEvent(null)}
              className="absolute top-3 right-3 text-stone-400 hover:text-white font-mono font-bold text-lg"
            >
              ✕
            </button>
            <div className="flex items-center gap-2">
              {getItemCategoryIcon(selectedEvent.type)}
              <span className="text-xs font-bold text-amber-400 font-mono">{selectedEvent.label}</span>
            </div>
            <h3 className="font-extrabold text-white text-base">{selectedEvent.title}</h3>
            <p className="text-xs text-stone-300">{selectedEvent.desc}</p>
            
            {/* Estimated Transportation Cost in Modal */}
            {selectedEvent.cost && (
              <div className="bg-black/80 p-3 rounded border border-emerald-500/50 text-xs text-emerald-300 font-mono">
                💴 <span className="font-bold">預估交通/票券費用：</span>{selectedEvent.cost}
              </div>
            )}

            {/* Food Recommendations List in Modal */}
            {selectedEvent.foodOptions && selectedEvent.foodOptions.length > 0 && (
              <div className="bg-amber-950/80 p-3 rounded border border-amber-600/50 space-y-2 text-xs">
                <div className="font-bold text-amber-300 font-mono flex items-center gap-1 border-b border-amber-600/40 pb-1">
                  <MinecraftIcons.Porkchop />
                  <span>大家推薦的熱門美食、價格與營業時間：</span>
                </div>
                <ul className="space-y-1.5 text-amber-100 list-disc list-inside">
                  {selectedEvent.foodOptions.map((item, idx) => (
                    <li key={idx} className="leading-relaxed">{item}</li>
                  ))}
                </ul>
              </div>
            )}

            {selectedEvent.note && (
              <div className="bg-black/80 p-3 rounded border border-amber-500/40 text-xs text-amber-200">
                💡 <span className="font-bold">密技備註：</span>{selectedEvent.note}
              </div>
            )}
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(selectedEvent.map || selectedEvent.title)}`}
              target="_blank"
              rel="noreferrer"
              className="block w-full py-2.5 bg-amber-500 text-black text-center font-bold rounded text-xs font-mono border-2 border-black active:scale-95 shadow-[2px_2px_0px_#000]"
            >
              🗺️ 開啟 Google Maps 導航
            </a>
          </div>
        </div>
      )}

      {/* ------------------------------------------------------------------- */}
      {/* BOTTOM NAVIGATION (MINECRAFT DUNGEONS HEAVY BAR)                    */}
      {/* ------------------------------------------------------------------- */}
      <nav className="fixed bottom-0 left-0 right-0 z-40 bg-[#1c120c] border-t-4 border-black px-2 py-2 shadow-2xl">
        <div className="max-w-md mx-auto grid grid-cols-6 gap-1 text-center font-mono">
          <button
            onClick={() => setActiveTab('schedule')}
            className={`flex flex-col items-center justify-center p-1.5 rounded transition border-2 active:scale-95 ${
              activeTab === 'schedule'
                ? 'bg-amber-500 text-black border-black font-black shadow-[2px_2px_0px_#000]'
                : 'bg-black/60 text-stone-300 border-transparent hover:bg-black/80'
            }`}
          >
            <MinecraftIcons.Pickaxe />
            <span className="text-[9px] mt-0.5">行程</span>
          </button>

          <button
            onClick={() => setActiveTab('bookings')}
            className={`flex flex-col items-center justify-center p-1.5 rounded transition border-2 active:scale-95 ${
              activeTab === 'bookings'
                ? 'bg-amber-500 text-black border-black font-black shadow-[2px_2px_0px_#000]'
                : 'bg-black/60 text-stone-300 border-transparent hover:bg-black/80'
            }`}
          >
            <MinecraftIcons.Bed />
            <span className="text-[9px] mt-0.5">預訂</span>
          </button>

          <button
            onClick={() => setActiveTab('expense')}
            className={`flex flex-col items-center justify-center p-1.5 rounded transition border-2 active:scale-95 ${
              activeTab === 'expense'
                ? 'bg-amber-500 text-black border-black font-black shadow-[2px_2px_0px_#000]'
                : 'bg-black/60 text-stone-300 border-transparent hover:bg-black/80'
            }`}
          >
            <MinecraftIcons.Emerald />
            <span className="text-[9px] mt-0.5">記帳</span>
          </button>

          <button
            onClick={() => setActiveTab('journal')}
            className={`flex flex-col items-center justify-center p-1.5 rounded transition border-2 active:scale-95 ${
              activeTab === 'journal'
                ? 'bg-amber-500 text-black border-black font-black shadow-[2px_2px_0px_#000]'
                : 'bg-black/60 text-stone-300 border-transparent hover:bg-black/80'
            }`}
          >
            <MinecraftIcons.Porkchop />
            <span className="text-[9px] mt-0.5">日誌</span>
          </button>

          <button
            onClick={() => setActiveTab('planning')}
            className={`flex flex-col items-center justify-center p-1.5 rounded transition border-2 active:scale-95 ${
              activeTab === 'planning'
                ? 'bg-amber-500 text-black border-black font-black shadow-[2px_2px_0px_#000]'
                : 'bg-black/60 text-stone-300 border-transparent hover:bg-black/80'
            }`}
          >
            <MinecraftIcons.Chest />
            <span className="text-[9px] mt-0.5">準備</span>
          </button>

          <button
            onClick={() => setActiveTab('members')}
            className={`flex flex-col items-center justify-center p-1.5 rounded transition border-2 active:scale-95 ${
              activeTab === 'members'
                ? 'bg-amber-500 text-black border-black font-black shadow-[2px_2px_0px_#000]'
                : 'bg-black/60 text-stone-300 border-transparent hover:bg-black/80'
            }`}
          >
            <MinecraftIcons.Creeper />
            <span className="text-[9px] mt-0.5">隊員</span>
          </button>
        </div>
      </nav>
    </div>
  );
}
